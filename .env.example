# ── Copy to .env and fill in. NEVER commit the real .env. ──────────────────

# Gemini API (required for OCR)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro

# OCR mode: 1 = Gemini-only (default, cheapest), 0 = hybrid (UTRNet + reconcile)
GEMINI_ONLY=1

# ── Authentication (exactly two users) ─────────────────────────────────────
# Format: username:password   (or username:sha256:<hex-digest> for hashed)
USER1_CREDENTIALS=admin:change-me-now
USER2_CREDENTIALS=editor:change-me-too

# Sign session cookies. Set a long random string so logins survive restarts.
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_SECONDS=43200
# Set to 1 when served over HTTPS (Replit deployment) to mark cookies Secure.
COOKIE_SECURE=0

# ── Tuning ─────────────────────────────────────────────────────────────────
PDF_RENDER_DPI=200
EST_OUTPUT_TOKENS_PER_PAGE=1200
# Pricing for the cost estimate ($ per 1M tokens), gemini-2.5-pro defaults:
RATE_INPUT_PER_M=1.25
RATE_OUTPUT_PER_M=10.0

# Storage / DB (defaults are fine for Replit)
DATABASE_URL=sqlite:///./ocr_suite.db
UPLOAD_DIR=storage/uploads
IMAGE_DIR=storage/pages
